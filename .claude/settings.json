{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync_deps.py\"",
            "timeout": 120,
            "statusMessage": "Syncing uv dependencies..."
          }
        ]
      }
    ]
  }
}
